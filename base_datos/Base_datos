import time
import psycopg
from robodk import robolink
from datetime import datetime

RDK = robolink.Robolink()

# Datos de la base de datos de pgAdmin
DB_CONFIG = {
    "dbname":   "gdi",
    "user":     "postgres",
    "password": "postgres",
    "host":     "localhost",
    "port":     "5432"
}

# IDs de los componentes (Tabla Almacen)
COD_CAJA_VACIA = "C001"
COD_BOLSA_A    = "C002"
COD_BOLSA_B    = "C003"
COD_TAPA       = "C004"
COD_MANUAL     = "C005"

# IDs de los tipos de caja (Tabla Tipo_Caja)
TIPO_AMARILLA = "TC01"
TIPO_ROJA     = "TC02"

def get_connection():
    return psycopg.connect(**DB_CONFIG)

def db_check_stock(codigo):
    """Mira si hay stock suficiente en el almacén antes de empezar."""
    conn = cur = None
    try:
        conn = get_connection()
        cur  = conn.cursor()
        sql  = "SELECT Stock_Actual, Stock_Minimo FROM Almacen WHERE Codigo = %s"
        cur.execute(sql, (codigo,))
        fila = cur.fetchone()
        
        if fila:
            stock_actual, stock_minimo = fila
            if stock_actual > stock_minimo:
                return True
            else:
                print(f"Alerta: Stock bajo para {codigo} ({stock_actual} unidades)")
                return False
        return False
    except Exception as e:
        print(f"Error al mirar stock: {e}")
        return False
    finally:
        if cur: cur.close()
        if conn: conn.close()

def db_registrar_caja(cod_fisico, tipo_num, num_localizador):
    """Guarda la caja en la tabla Caja al empezar la cinta."""
    cod_tipo = TIPO_AMARILLA if tipo_num == 1 else TIPO_ROJA
    nombre_tipo = "Caja Amarilla T1" if tipo_num == 1 else "Caja Roja T2"

    conn = cur = None
    try:
        conn = get_connection()
        cur  = conn.cursor()
        sql = """
            INSERT INTO Caja (Cod, Tipo, Acabada, Numero_localizador, Codigo_Tipo)
            VALUES (%s, %s, FALSE, %s, %s)
        """
        cur.execute(sql, (cod_fisico, nombre_tipo, num_localizador, cod_tipo))
        conn.commit()
        print(f"Caja {cod_fisico} registrada en el pedido {num_localizador}")
    except Exception as e:
        if conn: conn.rollback()
        print(f"Error al registrar caja: {e}")
    finally:
        if cur: cur.close()
        if conn: conn.close()

def db_finalizar_caja(cod_fisico):
    """Cambia Acabada a True cuando el robot termina el tapado."""
    conn = cur = None
    try:
        conn = get_connection()
        cur  = conn.cursor()
        sql  = "UPDATE Caja SET Acabada = TRUE WHERE Cod = %s"
        cur.execute(sql, (cod_fisico,))
        conn.commit()
        print(f"Caja {cod_fisico} terminada.")
    except Exception as e:
        if conn: conn.rollback()
        print(f"Error al finalizar: {e}")
    finally:
        if cur: cur.close()
        if conn: conn.close()

def db_descontar_stock(lista_componentes):
    """Resta 1 unidad de stock por cada pieza que use el robot."""
    conn = cur = None
    try:
        conn = get_connection()
        cur  = conn.cursor()
        sql  = "UPDATE Almacen SET Stock_Actual = Stock_Actual - 1 WHERE Codigo = %s"
        cur.executemany(sql, [(c,) for c in lista_componentes])
        conn.commit()
    except Exception as e:
        if conn: conn.rollback()
        print(f"Error al descontar stock: {e}")
    finally:
        if cur: cur.close()
        if conn: conn.close()

def _leer_param(nombre, default=""):
    try:
        val = RDK.getParam(nombre)
        return val if val else default
    except:
        return default

def run():
    num_localizador = _leer_param('NUMERO_PEDIDO', 'P001')
    total_t1 = int(_leer_param('INITIAL_P1', '0'))
    
    # Check de materiales inicial
    materiales = [COD_CAJA_VACIA, COD_BOLSA_A, COD_BOLSA_B, COD_TAPA, COD_MANUAL]
    for m in materiales:
        if not db_check_stock(m):
            print("Parando: No hay suficiente material.")
            return

    prev_c = int(_leer_param('CONTADOR_C', '0'))
    prev_t = int(_leer_param('CONTADOR_T', '0'))
    mapa_cajas = {}

    print(f"Iniciando pedido {num_localizador}...")

    while True:
        # Sensor de llenado
        curr_c = int(_leer_param('CONTADOR_C', '0'))
        if curr_c > prev_c:
            for i in range(prev_c + 1, curr_c + 1):
                id_fisico = f"LEGO_{num_localizador}_{i:03d}"
                tipo_num = 1 if i <= total_t1 else 2
                cod_bolsa = COD_BOLSA_A if tipo_num == 1 else COD_BOLSA_B
                
                db_registrar_caja(id_fisico, tipo_num, num_localizador)
                db_descontar_stock([COD_CAJA_VACIA, cod_bolsa])
                mapa_cajas[i] = id_fisico
            prev_c = curr_c

        # Sensor de tapado
        curr_t = int(_leer_param('CONTADOR_T', '0'))
        if curr_t > prev_t:
            for i in range(prev_t + 1, curr_t + 1):
                id_fisico = mapa_cajas.get(i)
                if id_fisico:
                    db_descontar_stock([COD_TAPA, COD_MANUAL])
                    db_finalizar_caja(id_fisico)
            prev_t = curr_t

        if _leer_param('ESTADO_PLANTA') == 'STOP':
            break
            
        time.sleep(0.5)

if __name__ == "__main__":
    run()
